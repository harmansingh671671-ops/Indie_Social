{
  "name": "sitehub",
  "private": true,
  "version": "0.1.0",
  "description": "SiteHub — a visual discovery feed for the indie web",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "typecheck": "npm run typecheck --workspace apps/web",
    "health": "node scripts/check-embeddable.mjs",
    "posters": "node scripts/fetch-posters.mjs && node scripts/optimize-posters.mjs",
    "posters:fetch": "node scripts/fetch-posters.mjs",
    "posters:optimize": "node scripts/optimize-posters.mjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
